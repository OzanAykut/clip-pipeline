{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "klip-studio-backend",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "studio.backend.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8765"
      ],
      "port": 8765,
      "url": "http://127.0.0.1:8765"
    },
    {
      "name": "klip-studio-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "studio/web",
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1"
      ],
      "port": 5173
    }
  ]
}